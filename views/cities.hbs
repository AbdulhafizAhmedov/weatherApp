<div class="container">

    {{#if cityErr}}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong> 
            {{cityErr}}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {{/if}}
</div>
    <div class="row h-75 h-sm-100 mx-3 mx-sm-auto">
        {{#each myCities}}
        
            <div class="col-12 col-sm-6 h-50 border-4 border-start border-bottom border-secondary-subtle border-end py-3 px-0 px-sm-auto rounded {{className}}">
                <h1 class="fs-1 mb-0 mb-sm-auto fw-bold text-light lh-sm ps-4">{{main.temp}}° <div class="mixed-icon"> <i class="{{iconName}}"></i> <i class="{{specIcon}}"></i> </div></h1>
                <p class="h5 text-light ms-5 mb-0">{{name}}</p>
            </div> 
        
        {{else}}
    </div>
        <p>City not found</p>
    {{/each}}
</div>